  {
   "date": "2026-09-19",
   "kind": "onchain",
   "chapter": "theft",
   "text": "12:20 and 12:49 UTC: two Lightning-to-on-chain swap-outs pay 67,819,900 and 72,069,900 sats to two of his addresses.",
   "source_url": null,
   "source_label": "Source: Blink post-mortem",
   "indicators": [
    {
     "id": "T-X13",
     "type": "tx",
     "value": "14bb5ce07a8c5c61ae8fd81c1ee4d3ddd9ab15f2b2f7f3ad3f15cc5e78691df7",
