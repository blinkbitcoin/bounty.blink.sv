  {
   "date": "2026-10-05",
   "kind": "onchain",
   "chapter": "ark",
   "text": "He exploits a bug in the boarding flow of Second's Ark server (built on bark, Second's implementation), taking 0.75 BTC of Second's own liquidity; no user funds were affected (Second's account). On chain, from 06:39 UTC his wallet pays round amounts into boarding outputs and exits them straight back to two collection addresses of his.",
   "source_url": "https://x.com/secondhq/status/2108065406665805992",
   "source_label": "Source: Second's public account",
