   "date": "2026-09-19",
   "kind": "record",
   "chapter": "lightning",
   "text": "Blink's payment records show at least 146,639,697 sats of the Lightning withdrawals going to his node aegis-ln.",
   "source_url": null,
   "source_label": "Source: Blink post-mortem",
   "indicators": [
