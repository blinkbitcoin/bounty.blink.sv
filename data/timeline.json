  {
   "date": "2026-09-10",
   "kind": "onchain",
   "chapter": "ecash",
   "text": "From 06:08 UTC on 10 September to 02:40 on 11 September, 435 peg-outs from 13 listed Fedimint federations and many unlisted ones (our estimate: roughly 70–90) pay 1,401,938,713 sats to one address of his. The federations are not involved: they are pre-existing community federations, and coins still in them belong to other users.",
   "source_url": null,
   "source_label": "Source: Blink post-mortem",
   "indicators": [
    {
     "id": "W-P001",
     "type": "tx",
     "value": "00370c1a86a9913fb8f939374e396258852ab8eb74ec6650640821db70dff6c2",
