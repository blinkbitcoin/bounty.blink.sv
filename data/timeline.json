  {
   "date": "2026-09-24",
   "kind": "public",
   "chapter": null,
   "text": "Every affected Blink balance restored in full, paid for by Blink's shareholders. No customer bears a loss.",
   "source_url": "https://www.blink.sv/blog/sept-19-attack-postmortem-and-bounty",
   "source_label": "Source: Blink post-mortem",
   "indicators": []
  },
  {
   "date": "2026-09-28",
   "kind": "onchain",
   "chapter": "trail",
   "text": "Liquidation day. In a chain of splits he pays chunks of 25,000,000–75,000,000 sats into the swap service. At 15:01 UTC he spends 150,009,622 sats of stolen coins together with 588,999,666 sats of coins he already controlled on 10 September — proving both belong to one owner.",
   "source_url": null,
   "source_label": "Source: Blink post-mortem",
