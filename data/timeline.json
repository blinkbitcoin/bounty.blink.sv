   "kind": "public",
   "chapter": null,
   "text": "Blink publishes the post-mortem and a recovery bounty.",
   "source_url": "https://www.blink.sv/blog/sept-19-attack-postmortem-and-bounty",
   "source_label": "Source: Blink post-mortem",
