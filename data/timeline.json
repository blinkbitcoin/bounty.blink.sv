  {
   "date": "2026-09-10",
   "kind": "onchain",
   "chapter": "lightning",
   "text": "His Lightning node aegis-ln opens its first channel, paid for only with coins from his wallet.",
   "source_url": null,
   "source_label": "Source: Blink post-mortem",
