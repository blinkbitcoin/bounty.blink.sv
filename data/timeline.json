  {
   "date": "2026-09-21",
   "kind": "onchain",
   "chapter": "trail",
   "text": "First outflow of stolen coins: 100,000,000 sats (1 BTC) paid into a cross-chain swap service that routes orders through NEAR Intents; 150,009,622 sats kept.",
   "source_url": null,
   "source_label": "Source: Blink post-mortem",
   "indicators": [
