  {
   "date": "2026-09-10",
   "kind": "onchain",
   "chapter": "ecash",
   "text": "08:23 UTC: those coins are swept and arranged into two coins of about 690,000,000 sats each — coins he controlled nine days before the attack.",
   "source_url": null,
   "source_label": "Source: Blink post-mortem",
